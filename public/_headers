# Keep the script hash in sync with the inline bootstrap in index.html.
# HTTPS connections and images remain open for user-selected diagnostic targets.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://www.gstatic.cn https://challenges.cloudflare.com; frame-src 'self' https://www.google.com https://www.recaptcha.net https://challenges.cloudflare.com; connect-src 'self' https://www.google.com https://www.recaptcha.net https://challenges.cloudflare.com; img-src 'self' data: blob: https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://www.gstatic.cn;
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), clipboard-read=(self), clipboard-write=(self), browsing-topics=()
  Strict-Transport-Security: max-age=31536000
